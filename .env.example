# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# ----- Database -----
# Local (matches docker-compose.yml defaults):
DB_URL=jdbc:postgresql://localhost:5432/techrecords
DB_USERNAME=techrecords
DB_PASSWORD=techrecords

# Neon (production) — replace with your Neon connection string:
# DB_URL=jdbc:postgresql://ep-xxx.us-east-2.aws.neon.tech/techrecords?sslmode=require
# DB_USERNAME=your_neon_user
# DB_PASSWORD=your_neon_password

# ----- JWT -----
# Use any long random string in production (min 32 chars recommended):
JWT_SECRET=ChangeThisToALongSecretKeyInProduction1234567890
JWT_EXPIRATION_MS=86400000   # 24 hours in milliseconds

# ----- CORS -----
# Comma-separated list of allowed frontend origins:
CORS_ORIGINS=http://localhost:4200,http://localhost

# Production:
# CORS_ORIGINS=https://your-site.netlify.app

# ----- File uploads -----
UPLOAD_DIR=./uploads
